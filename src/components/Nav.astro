---
const serviceLinks = [
  { href: "/services", label: "Overview" },
  { href: "/services/ai-agent-development-pune", label: "AI Agents" },
  { href: "/services/ai-automation-pune", label: "AI Automation" },
  { href: "/services/custom-software-development-pune", label: "Custom Software" },
  { href: "/services/web-application-development-pune", label: "Web Apps" },
  { href: "/services/mvp-development-pune", label: "MVP Development" },
  { href: "/services/flutter-app-development-pune", label: "Mobile Apps" },
  { href: "/services/api-integration-pune", label: "API Integration" },
  { href: "/services/ai-consulting-pune", label: "AI Consulting" },
];

const industryLinks = [
  { href: "/industries/manufacturing", label: "Manufacturing" },
  { href: "/industries/logistics", label: "Logistics" },
  { href: "/industries/education", label: "Education" },
  { href: "/industries/real-estate", label: "Real Estate" },
  { href: "/industries/healthcare", label: "Healthcare" },
  { href: "/industries/retail", label: "Retail" },
  { href: "/industries/restaurants", label: "Restaurants" },
  { href: "/industries/construction", label: "Construction" },
  { href: "/industries/pet-grooming", label: "Pet Grooming" },
];

const navLinks = [
  { href: "/portfolio", label: "Portfolio" },
  { href: "/about", label: "About" },
];

const resourceLinks = [
  { href: "/blog", label: "Blog" },
  { href: "/guides", label: "Guides" },
  { href: "/tools", label: "Tools" },
  { href: "/resources", label: "Resources" },
];

const currentPath = Astro.url.pathname;
const isServicesActive = serviceLinks.some(
  ({ href }) => currentPath === href || (href !== "/" && currentPath.startsWith(href))
);
const isResourcesActive = resourceLinks.some(
  ({ href }) => currentPath === href || (href !== "/" && currentPath.startsWith(href))
);
const isIndustriesActive = industryLinks.some(
  ({ href }) => currentPath === href || (href !== "/" && currentPath.startsWith(href))
);
---

<nav class="fixed w-full top-0 z-50 glass-panel border-b border-t-0 border-x-0" aria-label="Main navigation">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3 group -ml-2" aria-label="NextReach Studio — Home">
      <img src="/logo.png" alt="NextReach Studio" width="32" height="32" class="transition-transform duration-300 group-hover:scale-110" />
      <span class="text-white text-sm tracking-[0.08em] font-medium font-display">NextReach Studio</span>
    </a>

    <!-- Desktop Navigation -->
    <ul class="hidden md:flex items-center gap-1">
      <!-- Services Dropdown -->
      <li class="relative group" data-dd>
        <button
          data-dd-btn
          class={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm transition-all duration-200 font-medium cursor-pointer border ${
            isServicesActive
              ? "text-amber-400 bg-amber-500/5 border-amber-500/10 shadow-[0_0_15px_rgba(251,191,36,0.05)]"
              : "text-zinc-400 hover:text-zinc-200 hover:bg-white/5 border-transparent hover:border-white/5"
          }`}
          aria-expanded="false"
          aria-haspopup="true"
        >
          Services
          <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180 text-zinc-500 group-hover:text-zinc-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div data-dd-panel class="absolute left-0 top-full pt-2 w-52 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all duration-200 z-50">
          <div class="bg-zinc-950/95 border border-zinc-800/80 rounded-xl p-1.5 shadow-2xl backdrop-blur-xl max-h-[75vh] overflow-y-auto">
            {serviceLinks.map(({ href, label }) => {
              const isSubActive = currentPath === href || (href !== "/" && currentPath.startsWith(href));
              return (
                <a
                  href={href}
                  class={`block px-3 py-2 rounded-lg text-sm transition-colors duration-150 ${
                    isSubActive
                      ? "text-amber-400 bg-white/5 font-medium"
                      : "text-zinc-400 hover:text-white hover:bg-white/5"
                  }`}
                >
                  {label}
                </a>
              );
            })}
          </div>
        </div>
      </li>

      <!-- Industries Dropdown -->
      <li class="relative group" data-dd>
        <button
          data-dd-btn
          class={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm transition-all duration-200 font-medium cursor-pointer border ${
            isIndustriesActive
              ? "text-amber-400 bg-amber-500/5 border-amber-500/10 shadow-[0_0_15px_rgba(251,191,36,0.05)]"
              : "text-zinc-400 hover:text-zinc-200 hover:bg-white/5 border-transparent hover:border-white/5"
          }`}
          aria-expanded="false"
          aria-haspopup="true"
        >
          Industries
          <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180 text-zinc-500 group-hover:text-zinc-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div data-dd-panel class="absolute left-0 top-full pt-2 w-48 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all duration-200 z-50">
          <div class="bg-zinc-950/95 border border-zinc-800/80 rounded-xl p-1.5 shadow-2xl backdrop-blur-xl max-h-[75vh] overflow-y-auto">
            {industryLinks.map(({ href, label }) => {
              const isSubActive = currentPath === href || (href !== "/" && currentPath.startsWith(href));
              return (
                <a
                  href={href}
                  class={`block px-3 py-2 rounded-lg text-sm transition-colors duration-150 ${
                    isSubActive
                      ? "text-amber-400 bg-white/5 font-medium"
                      : "text-zinc-400 hover:text-white hover:bg-white/5"
                  }`}
                >
                  {label}
                </a>
              );
            })}
          </div>
        </div>
      </li>

      {navLinks.map(({ href, label }) => {
        const isActive = currentPath === href || (href !== "/" && currentPath.startsWith(href));
        return (
          <li>
            <a
              href={href}
              class={`px-3 py-1.5 rounded-lg text-sm transition-all duration-200 font-medium border ${
                isActive
                  ? "text-amber-400 bg-amber-500/5 border-amber-500/10 shadow-[0_0_15px_rgba(251,191,36,0.05)]"
                  : "text-zinc-400 hover:text-zinc-200 hover:bg-white/5 border-transparent hover:border-white/5"
              }`}
            >
              {label}
            </a>
          </li>
        );
      })}

      <!-- Resources Dropdown -->
      <li class="relative group" data-dd>
        <button
          data-dd-btn
          class={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm transition-all duration-200 font-medium cursor-pointer border ${
            isResourcesActive
              ? "text-amber-400 bg-amber-500/5 border-amber-500/10 shadow-[0_0_15px_rgba(251,191,36,0.05)]"
              : "text-zinc-400 hover:text-zinc-200 hover:bg-white/5 border-transparent hover:border-white/5"
          }`}
          aria-expanded="false"
          aria-haspopup="true"
        >
          Resources
          <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180 text-zinc-500 group-hover:text-zinc-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div data-dd-panel class="absolute left-0 top-full pt-2 w-48 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all duration-200 z-50">
          <div class="bg-zinc-950/95 border border-zinc-800/80 rounded-xl p-1.5 shadow-2xl backdrop-blur-xl">
            {resourceLinks.map(({ href, label }) => {
              const isSubActive = currentPath === href || (href !== "/" && currentPath.startsWith(href));
              return (
                <a
                  href={href}
                  class={`block px-3 py-2 rounded-lg text-sm transition-colors duration-150 ${
                    isSubActive
                      ? "text-amber-400 bg-white/5 font-medium"
                      : "text-zinc-400 hover:text-white hover:bg-white/5"
                  }`}
                >
                  {label}
                </a>
              );
            })}
          </div>
        </div>
      </li>

      <li>
        <a
          href="/contact"
          class={`px-3 py-1.5 rounded-lg text-sm transition-all duration-200 font-medium border ${
            currentPath === "/contact"
              ? "text-amber-400 bg-amber-500/5 border-amber-500/10 shadow-[0_0_15px_rgba(251,191,36,0.05)]"
              : "text-zinc-400 hover:text-zinc-200 hover:bg-white/5 border-transparent hover:border-white/5"
          }`}
        >
          Contact
        </a>
      </li>
    </ul>

    <!-- Mobile Hamburger Toggle -->
    <button
      id="mobile-menu-toggle"
      class="md:hidden flex items-center justify-center p-2 rounded-lg text-zinc-400 hover:text-white hover:bg-white/5 transition-colors focus:outline-none"
      aria-expanded="false"
      aria-label="Toggle navigation menu"
    >
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div
    id="mobile-menu"
    class="md:hidden border-t border-zinc-800/80 bg-zinc-950/95 backdrop-blur-xl transition-all duration-300 ease-in-out max-h-0 opacity-0 overflow-hidden"
  >
    <ul class="px-6 py-4 space-y-1.5">
      <!-- Mobile Services Header -->
      <li class="pb-1 px-4 text-[10px] font-bold uppercase tracking-wider text-zinc-500 font-display" data-mh="services" style="cursor:pointer">
        Services
        <svg data-mc="services" class="w-3.5 h-3.5 transition-transform duration-200 float-right" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
        </svg>
      </li>

      {serviceLinks.map(({ href, label }) => {
        const isActive = currentPath === href || (href !== "/" && currentPath.startsWith(href));
        return (
          <li data-ml="services" class="overflow-hidden transition-all duration-300 max-h-0 opacity-0">
            <a
              href={href}
              class={`block px-6 py-2 rounded-lg text-sm transition-all duration-200 ${
                isActive
                  ? "text-amber-400 bg-white/5 font-semibold border-l-2 border-amber-500 pl-5"
                  : "text-zinc-400 hover:text-zinc-200 hover:bg-white/5 pl-6"
              }`}
            >
              {label}
            </a>
          </li>
        );
      })}

      <!-- Mobile Industries Header -->
      <li class="pt-3 pb-1 px-4 text-[10px] font-bold uppercase tracking-wider text-zinc-500 font-display" data-mh="industries" style="cursor:pointer">
        Industries
        <svg data-mc="industries" class="w-3.5 h-3.5 transition-transform duration-200 float-right" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
        </svg>
      </li>

      {industryLinks.map(({ href, label }) => {
        const isActive = currentPath === href || (href !== "/" && currentPath.startsWith(href));
        return (
          <li data-ml="industries" class="overflow-hidden transition-all duration-300 max-h-0 opacity-0">
            <a
              href={href}
              class={`block px-6 py-2 rounded-lg text-sm transition-all duration-200 ${
                isActive
                  ? "text-amber-400 bg-white/5 font-semibold border-l-2 border-amber-500 pl-5"
                  : "text-zinc-400 hover:text-zinc-200 hover:bg-white/5 pl-6"
              }`}
            >
              {label}
            </a>
          </li>
        );
      })}

      {navLinks.map(({ href, label }) => {
        const isActive = currentPath === href || (href !== "/" && currentPath.startsWith(href));
        return (
          <li>
            <a
              href={href}
              class={`block px-4 py-2.5 rounded-lg text-sm transition-all duration-200 ${
                isActive
                  ? "text-white bg-white/5 font-semibold border-l-2 border-amber-400 pl-3"
                  : "text-zinc-400 hover:text-zinc-200 hover:bg-white/5 pl-4"
              }`}
            >
              {label}
            </a>
          </li>
        );
      })}

      <!-- Mobile Resources Header -->
      <li class="pt-3 pb-1 px-4 text-[10px] font-bold uppercase tracking-wider text-zinc-500 font-display" data-mh="resources" style="cursor:pointer">
        Resources
        <svg data-mc="resources" class="w-3.5 h-3.5 transition-transform duration-200 float-right" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
        </svg>
      </li>

      {resourceLinks.map(({ href, label }) => {
        const isActive = currentPath === href || (href !== "/" && currentPath.startsWith(href));
        return (
          <li data-ml="resources" class="overflow-hidden transition-all duration-300 max-h-0 opacity-0">
            <a
              href={href}
              class={`block px-6 py-2 rounded-lg text-sm transition-all duration-200 ${
                isActive
                  ? "text-amber-400 bg-white/5 font-semibold border-l-2 border-amber-500 pl-5"
                  : "text-zinc-400 hover:text-zinc-200 hover:bg-white/5 pl-6"
              }`}
            >
              {label}
            </a>
          </li>
        );
      })}

      <!-- Mobile Contact Link -->
      <li class="pt-3 mt-2 border-t border-zinc-900">
        <a
          href="/contact"
          class={`block px-4 py-2.5 rounded-lg text-sm transition-all duration-200 ${
            currentPath === "/contact"
              ? "text-white bg-white/5 font-semibold border-l-2 border-amber-400 pl-3"
              : "text-zinc-400 hover:text-zinc-200 hover:bg-white/5 pl-4"
          }`}
        >
          Contact
        </a>
      </li>
    </ul>
  </div>
</nav>

<script is:inline>
  (function () {
    "use strict";

    function initNav() {
      // === DESKTOP DROPDOWN CLICK TOGGLE ===
      var containers = document.querySelectorAll("[data-dd]");

      function ddClose() {
        containers.forEach(function (c) {
          var panel = c.querySelector("[data-dd-panel]");
          if (panel) {
            panel.style.removeProperty("opacity");
            panel.style.removeProperty("pointer-events");
          }
          var btn = c.querySelector("[data-dd-btn]");
          if (btn) btn.setAttribute("aria-expanded", "false");
          var chevron = c.querySelector("button svg");
          if (chevron) chevron.style.removeProperty("transform");
        });
      }

      containers.forEach(function (c) {
        var btn = c.querySelector("[data-dd-btn]");
        if (!btn) return;
        btn.addEventListener("click", function (e) {
          e.stopPropagation();
          var panel = c.querySelector("[data-dd-panel]");
          var chevron = c.querySelector("button svg");
          var isOpen = panel && (panel.style.opacity === "1" || panel.style.pointerEvents === "auto");

          ddClose();

          if (!isOpen) {
            if (panel) {
              panel.style.setProperty("opacity", "1");
              panel.style.setProperty("pointer-events", "auto");
            }
            btn.setAttribute("aria-expanded", "true");
            if (chevron) chevron.style.setProperty("transform", "rotate(180deg)");
          }
        });
      });

      document.addEventListener("click", function (e) {
        var hit = false;
        containers.forEach(function (c) { if (c.contains(e.target)) hit = true; });
        if (!hit) ddClose();
      });

      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape") ddClose();
      });

      // === MOBILE HAMBURGER ===
      var toggleBtn = document.getElementById("mobile-menu-toggle");
      var mobileMenu = document.getElementById("mobile-menu");
      var menuIcon = document.getElementById("menu-icon");

      function setMobileOpen(open) {
        if (!toggleBtn || !mobileMenu || !menuIcon) return;
        toggleBtn.setAttribute("aria-expanded", String(open));
        if (open) {
          mobileMenu.classList.remove("max-h-0", "opacity-0");
          mobileMenu.classList.add("max-h-[700px]", "opacity-100");
          menuIcon.setAttribute("d", "M6 18L18 6M6 6l12 12");
        } else {
          mobileMenu.classList.remove("max-h-[700px]", "opacity-100");
          mobileMenu.classList.add("max-h-0", "opacity-0");
          menuIcon.setAttribute("d", "M4 6h16M4 12h16M4 18h16");
        }
      }

      if (toggleBtn && mobileMenu && menuIcon) {
        toggleBtn.addEventListener("click", function () {
          setMobileOpen(toggleBtn.getAttribute("aria-expanded") !== "true");
        });
      }

      if (mobileMenu) {
        mobileMenu.querySelectorAll("a").forEach(function (a) {
          a.addEventListener("click", function () { setMobileOpen(false); });
        });
      }

      // === MOBILE COLLAPSIBLE SECTIONS ===
      var mhEls = document.querySelectorAll("[data-mh]");

      function closeAllMh() {
        mhEls.forEach(function (el) {
          var id = el.getAttribute("data-mh");
          var items = document.querySelectorAll("[data-ml='" + id + "']");
          items.forEach(function (item) {
            item.classList.add("max-h-0", "opacity-0");
            item.classList.remove("max-h-[500px]", "opacity-100");
          });
          var chevron = document.querySelector("[data-mc='" + id + "']");
          if (chevron) chevron.classList.remove("rotate-180");
        });
      }

      mhEls.forEach(function (el) {
        el.addEventListener("click", function () {
          var id = el.getAttribute("data-mh");
          var firstItem = document.querySelector("[data-ml='" + id + "']");
          var isOpen = firstItem && !firstItem.classList.contains("max-h-0");

          closeAllMh();

          if (!isOpen) {
            var items = document.querySelectorAll("[data-ml='" + id + "']");
            items.forEach(function (item) {
              item.classList.remove("max-h-0", "opacity-0");
              item.classList.add("max-h-[500px]", "opacity-100");
            });
            var chevron = document.querySelector("[data-mc='" + id + "']");
            if (chevron) chevron.classList.add("rotate-180");
          }
        });
      });

      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape") { setMobileOpen(false); ddClose(); closeAllMh(); }
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initNav);
    } else {
      initNav();
    }
  })();
</script>

