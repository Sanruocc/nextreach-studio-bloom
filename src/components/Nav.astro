---
const serviceLinks = [
  { href: "/services", label: "Overview" },
  { href: "/services/ai-agent-development-pune", label: "AI Agents" },
  { href: "/services/ai-automation-pune", label: "AI Automation" },
  { href: "/services/custom-software-development-pune", label: "Custom Software" },
  { href: "/services/web-application-development-pune", label: "Web Apps" },
  { href: "/services/mvp-development-pune", label: "MVP Development" },
  { href: "/services/flutter-app-development-pune", label: "Mobile Apps" },
  { href: "/services/api-integration-pune", label: "API Integration" },
  { href: "/services/ai-consulting-pune", label: "AI Consulting" },
];

const industryLinks = [
  { href: "/industries/manufacturing", label: "Manufacturing" },
  { href: "/industries/logistics", label: "Logistics" },
  { href: "/industries/education", label: "Education" },
  { href: "/industries/real-estate", label: "Real Estate" },
  { href: "/industries/healthcare", label: "Healthcare" },
  { href: "/industries/retail", label: "Retail" },
  { href: "/industries/restaurants", label: "Restaurants" },
  { href: "/industries/construction", label: "Construction" },
  { href: "/industries/pet-grooming", label: "Pet Grooming" },
];

const navLinks = [
  { href: "/portfolio", label: "Portfolio" },
  { href: "/about", label: "About" },
];

const resourceLinks = [
  { href: "/blog", label: "Blog" },
  { href: "/guides", label: "Guides" },
  { href: "/tools", label: "Tools" },
  { href: "/resources", label: "Resources" },
];

const currentPath = Astro.url.pathname;
const isServicesActive = serviceLinks.some(
  ({ href }) => currentPath === href || (href !== "/" && currentPath.startsWith(href))
);
const isResourcesActive = resourceLinks.some(
  ({ href }) => currentPath === href || (href !== "/" && currentPath.startsWith(href))
);
const isIndustriesActive = industryLinks.some(
  ({ href }) => currentPath === href || (href !== "/" && currentPath.startsWith(href))
);
---

<nav class="fixed w-full top-0 z-50 glass-panel !rounded-none !overflow-visible border-b border-t-0 border-x-0" aria-label="Main navigation">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3 group -ml-2" aria-label="NextReach Studio — Home">
      <img src="/logo.png" alt="NextReach Studio" width="32" height="32" class="transition-transform duration-300 group-hover:scale-110" />
      <span class="text-white text-sm tracking-[0.08em] font-medium font-display">NextReach Studio</span>
    </a>

    <!-- Desktop Navigation -->
    <ul class="hidden md:flex items-center gap-1">
      <!-- Services Dropdown -->
      <li class="relative group" data-dd data-open="false">
        <button
          type="button"
          data-dd-btn
          class={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm transition-all duration-200 font-medium cursor-pointer border ${
            isServicesActive
              ? "text-amber-400 bg-amber-500/5 border-amber-500/10 shadow-[0_0_15px_rgba(251,191,36,0.05)]"
              : "text-zinc-400 hover:text-zinc-200 hover:bg-white/5 border-transparent hover:border-white/5"
          }`}
          aria-expanded="false"
          aria-haspopup="true"
        >
          <span>Services</span>
          <svg data-dd-chevron class="w-3.5 h-3.5 transition-transform duration-200 text-zinc-500 group-hover:text-zinc-300 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div
          data-dd-panel
          class="absolute left-0 top-full pt-2 w-56 opacity-0 pointer-events-none -translate-y-1 transition-all duration-200 ease-out z-50 group-hover:opacity-100 group-hover:pointer-events-auto group-hover:translate-y-0 group-focus-within:opacity-100 group-focus-within:pointer-events-auto group-focus-within:translate-y-0"
        >
          <div class="bg-zinc-950/95 border border-zinc-800/80 rounded-xl p-1.5 shadow-2xl backdrop-blur-xl max-h-[75vh] overflow-y-auto">
            {serviceLinks.map(({ href, label }) => {
              const isSubActive = currentPath === href || (href !== "/" && currentPath.startsWith(href));
              return (
                <a
                  href={href}
                  class={`block px-3 py-2 rounded-lg text-sm transition-colors duration-150 ${
                    isSubActive
                      ? "text-amber-400 bg-amber-500/10 font-medium"
                      : "text-zinc-400 hover:text-white hover:bg-white/5"
                  }`}
                >
                  {label}
                </a>
              );
            })}
          </div>
        </div>
      </li>

      <!-- Industries Dropdown -->
      <li class="relative group" data-dd data-open="false">
        <button
          type="button"
          data-dd-btn
          class={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm transition-all duration-200 font-medium cursor-pointer border ${
            isIndustriesActive
              ? "text-amber-400 bg-amber-500/5 border-amber-500/10 shadow-[0_0_15px_rgba(251,191,36,0.05)]"
              : "text-zinc-400 hover:text-zinc-200 hover:bg-white/5 border-transparent hover:border-white/5"
          }`}
          aria-expanded="false"
          aria-haspopup="true"
        >
          <span>Industries</span>
          <svg data-dd-chevron class="w-3.5 h-3.5 transition-transform duration-200 text-zinc-500 group-hover:text-zinc-300 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div
          data-dd-panel
          class="absolute left-0 top-full pt-2 w-52 opacity-0 pointer-events-none -translate-y-1 transition-all duration-200 ease-out z-50 group-hover:opacity-100 group-hover:pointer-events-auto group-hover:translate-y-0 group-focus-within:opacity-100 group-focus-within:pointer-events-auto group-focus-within:translate-y-0"
        >
          <div class="bg-zinc-950/95 border border-zinc-800/80 rounded-xl p-1.5 shadow-2xl backdrop-blur-xl max-h-[75vh] overflow-y-auto">
            {industryLinks.map(({ href, label }) => {
              const isSubActive = currentPath === href || (href !== "/" && currentPath.startsWith(href));
              return (
                <a
                  href={href}
                  class={`block px-3 py-2 rounded-lg text-sm transition-colors duration-150 ${
                    isSubActive
                      ? "text-amber-400 bg-amber-500/10 font-medium"
                      : "text-zinc-400 hover:text-white hover:bg-white/5"
                  }`}
                >
                  {label}
                </a>
              );
            })}
          </div>
        </div>
      </li>

      {navLinks.map(({ href, label }) => {
        const isActive = currentPath === href || (href !== "/" && currentPath.startsWith(href));
        return (
          <li>
            <a
              href={href}
              class={`px-3 py-1.5 rounded-lg text-sm transition-all duration-200 font-medium border ${
                isActive
                  ? "text-amber-400 bg-amber-500/5 border-amber-500/10 shadow-[0_0_15px_rgba(251,191,36,0.05)]"
                  : "text-zinc-400 hover:text-zinc-200 hover:bg-white/5 border-transparent hover:border-white/5"
              }`}
            >
              {label}
            </a>
          </li>
        );
      })}

      <!-- Resources Dropdown -->
      <li class="relative group" data-dd data-open="false">
        <button
          type="button"
          data-dd-btn
          class={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm transition-all duration-200 font-medium cursor-pointer border ${
            isResourcesActive
              ? "text-amber-400 bg-amber-500/5 border-amber-500/10 shadow-[0_0_15px_rgba(251,191,36,0.05)]"
              : "text-zinc-400 hover:text-zinc-200 hover:bg-white/5 border-transparent hover:border-white/5"
          }`}
          aria-expanded="false"
          aria-haspopup="true"
        >
          <span>Resources</span>
          <svg data-dd-chevron class="w-3.5 h-3.5 transition-transform duration-200 text-zinc-500 group-hover:text-zinc-300 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div
          data-dd-panel
          class="absolute right-0 top-full pt-2 w-48 opacity-0 pointer-events-none -translate-y-1 transition-all duration-200 ease-out z-50 group-hover:opacity-100 group-hover:pointer-events-auto group-hover:translate-y-0 group-focus-within:opacity-100 group-focus-within:pointer-events-auto group-focus-within:translate-y-0"
        >
          <div class="bg-zinc-950/95 border border-zinc-800/80 rounded-xl p-1.5 shadow-2xl backdrop-blur-xl">
            {resourceLinks.map(({ href, label }) => {
              const isSubActive = currentPath === href || (href !== "/" && currentPath.startsWith(href));
              return (
                <a
                  href={href}
                  class={`block px-3 py-2 rounded-lg text-sm transition-colors duration-150 ${
                    isSubActive
                      ? "text-amber-400 bg-amber-500/10 font-medium"
                      : "text-zinc-400 hover:text-white hover:bg-white/5"
                  }`}
                >
                  {label}
                </a>
              );
            })}
          </div>
        </div>
      </li>

      <li>
        <a
          href="/contact"
          class={`px-3 py-1.5 rounded-lg text-sm transition-all duration-200 font-medium border ${
            currentPath === "/contact"
              ? "text-amber-400 bg-amber-500/5 border-amber-500/10 shadow-[0_0_15px_rgba(251,191,36,0.05)]"
              : "text-zinc-400 hover:text-zinc-200 hover:bg-white/5 border-transparent hover:border-white/5"
          }`}
        >
          Contact
        </a>
      </li>
    </ul>

    <!-- Mobile Hamburger Toggle -->
    <button
      id="mobile-menu-toggle"
      type="button"
      class="md:hidden flex items-center justify-center p-2 rounded-lg text-zinc-400 hover:text-white hover:bg-white/5 transition-colors focus:outline-none cursor-pointer"
      aria-expanded="false"
      aria-label="Toggle navigation menu"
    >
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-zinc-800/80 bg-zinc-950/95 backdrop-blur-xl max-h-[80vh] overflow-y-auto shadow-2xl"
  >
    <ul class="px-4 py-4 space-y-2">
      <!-- Mobile Services Header -->
      <li class="space-y-1">
        <button
          type="button"
          data-mobile-toggle="services"
          class={`w-full flex items-center justify-between px-3 py-2.5 rounded-lg text-sm font-semibold transition-colors cursor-pointer ${
            isServicesActive ? "text-amber-400 bg-amber-500/10" : "text-zinc-300 hover:text-white hover:bg-white/5"
          }`}
          aria-expanded={isServicesActive ? "true" : "false"}
        >
          <span class="flex items-center gap-2">
            <span>Services</span>
            <span class="px-2 py-0.5 text-[10px] font-medium rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20">9</span>
          </span>
          <svg
            data-mobile-chevron="services"
            class={`w-4 h-4 text-zinc-400 transition-transform duration-200 ${isServicesActive ? "rotate-180" : ""}`}
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div
          data-mobile-submenu="services"
          class={`pl-3 space-y-1 border-l-2 border-amber-500/20 ml-3 my-1 ${isServicesActive ? "" : "hidden"}`}
        >
          {serviceLinks.map(({ href, label }) => {
            const isActive = currentPath === href || (href !== "/" && currentPath.startsWith(href));
            return (
              <a
                href={href}
                class={`block px-3 py-2 rounded-lg text-sm transition-all duration-150 ${
                  isActive
                    ? "text-amber-400 bg-white/5 font-semibold border-l-2 border-amber-400 -ml-3.5 pl-3"
                    : "text-zinc-400 hover:text-zinc-200 hover:bg-white/5"
                }`}
              >
                {label}
              </a>
            );
          })}
        </div>
      </li>

      <!-- Mobile Industries Header -->
      <li class="space-y-1">
        <button
          type="button"
          data-mobile-toggle="industries"
          class={`w-full flex items-center justify-between px-3 py-2.5 rounded-lg text-sm font-semibold transition-colors cursor-pointer ${
            isIndustriesActive ? "text-amber-400 bg-amber-500/10" : "text-zinc-300 hover:text-white hover:bg-white/5"
          }`}
          aria-expanded={isIndustriesActive ? "true" : "false"}
        >
          <span class="flex items-center gap-2">
            <span>Industries</span>
            <span class="px-2 py-0.5 text-[10px] font-medium rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20">9</span>
          </span>
          <svg
            data-mobile-chevron="industries"
            class={`w-4 h-4 text-zinc-400 transition-transform duration-200 ${isIndustriesActive ? "rotate-180" : ""}`}
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div
          data-mobile-submenu="industries"
          class={`pl-3 space-y-1 border-l-2 border-amber-500/20 ml-3 my-1 ${isIndustriesActive ? "" : "hidden"}`}
        >
          {industryLinks.map(({ href, label }) => {
            const isActive = currentPath === href || (href !== "/" && currentPath.startsWith(href));
            return (
              <a
                href={href}
                class={`block px-3 py-2 rounded-lg text-sm transition-all duration-150 ${
                  isActive
                    ? "text-amber-400 bg-white/5 font-semibold border-l-2 border-amber-400 -ml-3.5 pl-3"
                    : "text-zinc-400 hover:text-zinc-200 hover:bg-white/5"
                }`}
              >
                {label}
              </a>
            );
          })}
        </div>
      </li>

      {navLinks.map(({ href, label }) => {
        const isActive = currentPath === href || (href !== "/" && currentPath.startsWith(href));
        return (
          <li>
            <a
              href={href}
              class={`block px-3 py-2.5 rounded-lg text-sm font-semibold transition-all duration-150 ${
                isActive
                  ? "text-amber-400 bg-amber-500/10"
                  : "text-zinc-300 hover:text-white hover:bg-white/5"
              }`}
            >
              {label}
            </a>
          </li>
        );
      })}

      <!-- Mobile Resources Header -->
      <li class="space-y-1">
        <button
          type="button"
          data-mobile-toggle="resources"
          class={`w-full flex items-center justify-between px-3 py-2.5 rounded-lg text-sm font-semibold transition-colors cursor-pointer ${
            isResourcesActive ? "text-amber-400 bg-amber-500/10" : "text-zinc-300 hover:text-white hover:bg-white/5"
          }`}
          aria-expanded={isResourcesActive ? "true" : "false"}
        >
          <span class="flex items-center gap-2">
            <span>Resources</span>
            <span class="px-2 py-0.5 text-[10px] font-medium rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20">4</span>
          </span>
          <svg
            data-mobile-chevron="resources"
            class={`w-4 h-4 text-zinc-400 transition-transform duration-200 ${isResourcesActive ? "rotate-180" : ""}`}
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div
          data-mobile-submenu="resources"
          class={`pl-3 space-y-1 border-l-2 border-amber-500/20 ml-3 my-1 ${isResourcesActive ? "" : "hidden"}`}
        >
          {resourceLinks.map(({ href, label }) => {
            const isActive = currentPath === href || (href !== "/" && currentPath.startsWith(href));
            return (
              <a
                href={href}
                class={`block px-3 py-2 rounded-lg text-sm transition-all duration-150 ${
                  isActive
                    ? "text-amber-400 bg-white/5 font-semibold border-l-2 border-amber-400 -ml-3.5 pl-3"
                    : "text-zinc-400 hover:text-zinc-200 hover:bg-white/5"
                }`}
              >
                {label}
              </a>
            );
          })}
        </div>
      </li>

      <!-- Mobile Contact Link -->
      <li class="pt-2 mt-2 border-t border-zinc-800/60">
        <a
          href="/contact"
          class={`block px-3 py-2.5 rounded-lg text-sm font-semibold transition-all duration-150 ${
            currentPath === "/contact"
              ? "text-amber-400 bg-amber-500/10"
              : "text-zinc-300 hover:text-white hover:bg-white/5"
          }`}
        >
          Contact
        </a>
      </li>
    </ul>
  </div>
</nav>

<style>
  /* Explicitly prevent fixed <nav> from clipping absolute desktop dropdown panels */
  nav {
    overflow: visible !important;
  }

  /* Desktop Dropdown Open State when toggled via click or active state */
  [data-dd][data-open="true"] [data-dd-panel] {
    opacity: 1 !important;
    pointer-events: auto !important;
    transform: translateY(0) !important;
  }

  [data-dd][data-open="true"] [data-dd-chevron] {
    transform: rotate(180deg) !important;
  }
</style>

<script is:inline>
  (function () {
    "use strict";

    function initNav() {
      // === DESKTOP DROPDOWNS ===
      var ddContainers = document.querySelectorAll("[data-dd]");

      function closeAllDesktop() {
        ddContainers.forEach(function (container) {
          container.setAttribute("data-open", "false");
          var btn = container.querySelector("[data-dd-btn]");
          if (btn) btn.setAttribute("aria-expanded", "false");
        });
      }

      ddContainers.forEach(function (container) {
        var btn = container.querySelector("[data-dd-btn]");
        var panel = container.querySelector("[data-dd-panel]");
        if (!btn || !panel) return;

        btn.addEventListener("click", function (e) {
          e.stopPropagation();
          var isOpen = container.getAttribute("data-open") === "true";

          closeAllDesktop();

          if (!isOpen) {
            container.setAttribute("data-open", "true");
            btn.setAttribute("aria-expanded", "true");
          }
        });
      });

      // === MOBILE HAMBURGER & ACCORDION ===
      var toggleBtn = document.getElementById("mobile-menu-toggle");
      var mobileMenu = document.getElementById("mobile-menu");
      var menuIcon = document.getElementById("menu-icon");

      function setMobileOpen(open) {
        if (!toggleBtn || !mobileMenu) return;
        toggleBtn.setAttribute("aria-expanded", String(open));
        if (open) {
          mobileMenu.classList.remove("hidden");
          if (menuIcon) menuIcon.setAttribute("d", "M6 18L18 6M6 6l12 12");
        } else {
          mobileMenu.classList.add("hidden");
          if (menuIcon) menuIcon.setAttribute("d", "M4 6h16M4 12h16M4 18h16");
        }
      }

      if (toggleBtn && mobileMenu) {
        toggleBtn.addEventListener("click", function () {
          var isOpen = toggleBtn.getAttribute("aria-expanded") === "true";
          setMobileOpen(!isOpen);
        });

        // Submenu Toggles inside Mobile Menu
        var mobileToggles = mobileMenu.querySelectorAll("[data-mobile-toggle]");
        mobileToggles.forEach(function (toggle) {
          toggle.addEventListener("click", function () {
            var sectionId = toggle.getAttribute("data-mobile-toggle");
            var submenu = mobileMenu.querySelector('[data-mobile-submenu="' + sectionId + '"]');
            var chevron = mobileMenu.querySelector('[data-mobile-chevron="' + sectionId + '"]');

            if (!submenu) return;
            var isSubmenuOpen = !submenu.classList.contains("hidden");

            // Close all submenus
            mobileMenu.querySelectorAll("[data-mobile-submenu]").forEach(function (s) {
              s.classList.add("hidden");
            });
            mobileMenu.querySelectorAll("[data-mobile-chevron]").forEach(function (c) {
              c.classList.remove("rotate-180");
            });
            mobileMenu.querySelectorAll("[data-mobile-toggle]").forEach(function (t) {
              t.setAttribute("aria-expanded", "false");
            });

            // Toggle selected submenu
            if (!isSubmenuOpen) {
              submenu.classList.remove("hidden");
              toggle.setAttribute("aria-expanded", "true");
              if (chevron) chevron.classList.add("rotate-180");
            }
          });
        });

        // Close mobile menu when any navigation link inside is clicked
        mobileMenu.querySelectorAll("a").forEach(function (a) {
          a.addEventListener("click", function () {
            setMobileOpen(false);
          });
        });
      }

      // === GLOBAL EVENT LISTENERS (Click Outside & Escape Key) ===
      document.addEventListener("click", function (e) {
        if (!e.target.closest("[data-dd]")) {
          closeAllDesktop();
        }
      });

      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape") {
          closeAllDesktop();
          setMobileOpen(false);
        }
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initNav);
    } else {
      initNav();
    }
  })();
</script>
