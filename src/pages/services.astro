---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import Prose from "@/components/Prose.astro";
---

<Layout
  title="Our Services — Web App & Automation Solutions"
  description="We provide custom web application development, workflow automation, internal tools, and MVP development for startups and small-to-medium businesses."
>
  <Nav />
  <main class="container-page-wide relative">
    <div class="absolute top-0 left-1/4 -translate-y-12 w-[500px] h-[300px] bg-amber-400/5 rounded-full blur-[100px] pointer-events-none -z-10 animate-pulse-glow" aria-hidden="true"></div>

    <header class="header-page animate-fade-in-up max-w-4xl mx-auto px-4 text-center">
      <p class="header-page-pretitle inline-block">Services</p>
      <h1 class="header-page-title">Practical, focused custom software</h1>
      <p class="header-page-subtitle mx-auto font-body">
        We specialize in one-time, scoped development projects designed to make your operations smoother, launch your product ideas, or automate manual processes.
      </p>
    </header>

    <!-- Detailed Services Grid -->
    <div class="space-y-12 max-w-4xl mx-auto px-4 mb-16">
      
      <!-- Service 1: Web App Development -->
      <div class="card-cyber">
        <div class="flex flex-col md:flex-row md:items-start gap-6">
          <div class="icon-glow-wrapper shrink-0">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <line x1="2" y1="12" x2="22" y2="12"/>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
            </svg>
          </div>
          <div class="flex-1 space-y-4">
            <div>
              <h2 class="text-xl font-bold text-white font-display mb-1.5">Custom Web Applications</h2>
              <p class="text-xs text-zinc-400 leading-relaxed font-body">
                Clean, responsive, database-driven web platforms tailored to your business operations. Perfect for businesses needing custom interfaces that off-the-shelf software can't support.
              </p>
            </div>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
              <div>
                <h4 class="text-xs font-semibold text-zinc-300 uppercase tracking-wider mb-2 font-display">What's Included</h4>
                <ul class="space-y-1.5 text-xs text-zinc-400 font-body">
                  <li class="flex gap-2"><span>✓</span><span>Custom UI & UX design</span></li>
                  <li class="flex gap-2"><span>✓</span><span>PostgreSQL Database structure</span></li>
                  <li class="flex gap-2"><span>✓</span><span>User authentication & permissions</span></li>
                  <li class="flex gap-2"><span>✓</span><span>Deployment & server setup</span></li>
                </ul>
              </div>
              <div>
                <h4 class="text-xs font-semibold text-zinc-300 uppercase tracking-wider mb-2 font-display">Engagement Fit</h4>
                <ul class="space-y-1 text-xs text-zinc-400 font-body">
                  <li><strong>Ideal Client:</strong> Growing local businesses, SMEs, logistics companies.</li>
                  <li><strong>Budget Scale:</strong> Scoped, affordable project-based pricing.</li>
                  <li><strong>Timeline:</strong> 4 to 8 weeks.</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Service 2: Business Automation & Internal Tools -->
      <div class="card-cyber">
        <div class="flex flex-col md:flex-row md:items-start gap-6">
          <div class="icon-glow-wrapper shrink-0">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="3"/>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
            </svg>
          </div>
          <div class="flex-1 space-y-4">
            <div>
              <h2 class="text-xl font-bold text-white font-display mb-1.5">Business Automation &amp; Internal Tools</h2>
              <p class="text-xs text-zinc-400 leading-relaxed font-body">
                Connect your business apps, eliminate repetitive copy-pasting, and build dashboard interfaces that centralize your business metrics.
              </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
              <div>
                <h4 class="text-xs font-semibold text-zinc-300 uppercase tracking-wider mb-2 font-display">What's Included</h4>
                <ul class="space-y-1.5 text-xs text-zinc-400 font-body">
                  <li class="flex gap-2"><span>✓</span><span>API integrations & webhooks</span></li>
                  <li class="flex gap-2"><span>✓</span><span>Custom admin dashboards</span></li>
                  <li class="flex gap-2"><span>✓</span><span>Spreadsheet to database migration</span></li>
                  <li class="flex gap-2"><span>✓</span><span>Email/WhatsApp notification alerts</span></li>
                </ul>
              </div>
              <div>
                <h4 class="text-xs font-semibold text-zinc-300 uppercase tracking-wider mb-2 font-display">Engagement Fit</h4>
                <ul class="space-y-1 text-xs text-zinc-400 font-body">
                  <li><strong>Ideal Client:</strong> Trade, retail, distribution, and local service businesses.</li>
                  <li><strong>Budget Scale:</strong> Practical, entry-level custom budget.</li>
                  <li><strong>Timeline:</strong> 2 to 4 weeks.</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Service 3: MVP Development -->
      <div class="card-cyber">
        <div class="flex flex-col md:flex-row md:items-start gap-6">
          <div class="icon-glow-wrapper shrink-0">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4.5 16.5c-1.5 1.26-2 3.38-2 3.38s2.12-.5 3.38-2c1.26-1.5 2.12-3.38 2.12-3.38s-2.12.5-3.38 2z"/>
              <path d="M12 12L4.5 19.5"/>
              <path d="M9 15l2 2"/>
              <path d="M19 9c-1.5 1.5-4 1.5-5.5 0s-1.5-4 0-5.5C15 2 21 2 21 2s0 6-2 7z"/>
            </svg>
          </div>
          <div class="flex-1 space-y-4">
            <div>
              <h2 class="text-xl font-bold text-white font-display mb-1.5">MVP &amp; Startup Prototyping</h2>
              <p class="text-xs text-zinc-400 leading-relaxed font-body">
                Turn your software idea into a functional web or mobile application that real users can log in to, use, and pay for. Focuses strictly on core value.
              </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
              <div>
                <h4 class="text-xs font-semibold text-zinc-300 uppercase tracking-wider mb-2 font-display">What's Included</h4>
                <ul class="space-y-1.5 text-xs text-zinc-400 font-body">
                  <li class="flex gap-2"><span>✓</span><span>Feature scoping & prioritization</span></li>
                  <li class="flex gap-2"><span>✓</span><span>Stripe payment processing flow</span></li>
                  <li class="flex gap-2"><span>✓</span><span>Scalable serverless/backend logic</span></li>
                  <li class="flex gap-2"><span>✓</span><span>Full analytics & log configuration</span></li>
                </ul>
              </div>
              <div>
                <h4 class="text-xs font-semibold text-zinc-300 uppercase tracking-wider mb-2 font-display">Engagement Fit</h4>
                <ul class="space-y-1 text-xs text-zinc-400 font-body">
                  <li><strong>Ideal Client:</strong> Solo founders, early-stage bootstrap startups.</li>
                  <li><strong>Budget Scale:</strong> Streamlined, founder-friendly package.</li>
                  <li><strong>Timeline:</strong> 4 to 6 weeks.</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Service 4: AI Systems Integration -->
      <div class="card-cyber">
        <div class="flex flex-col md:flex-row md:items-start gap-6">
          <div class="icon-glow-wrapper shrink-0">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="4" y="4" width="16" height="16" rx="2"/>
              <rect x="9" y="9" width="6" height="6" rx="1"/>
              <line x1="9" y1="1" x2="9" y2="4"/>
              <line x1="15" y1="1" x2="15" y2="4"/>
              <line x1="9" y1="20" x2="9" y2="23"/>
              <line x1="15" y1="20" x2="15" y2="23"/>
              <line x1="20" y1="9" x2="23" y2="9"/>
              <line x1="20" y1="15" x2="23" y2="15"/>
              <line x1="1" y1="9" x2="4" y2="9"/>
              <line x1="1" y1="15" x2="4" y2="15"/>
            </svg>
          </div>
          <div class="flex-1 space-y-4">
            <div>
              <h2 class="text-xl font-bold text-white font-display mb-1.5">AI Systems Integration</h2>
              <p class="text-xs text-zinc-400 leading-relaxed font-body">
                Enhance your business products with intelligent features. We build practical integrations using OpenAI, Anthropic, or local open-source models.
              </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
              <div>
                <h4 class="text-xs font-semibold text-zinc-300 uppercase tracking-wider mb-2 font-display">What's Included</h4>
                <ul class="space-y-1.5 text-xs text-zinc-400 font-body">
                  <li class="flex gap-2"><span>✓</span><span>Semantic search & vector database setups</span></li>
                  <li class="flex gap-2"><span>✓</span><span>Prompt engineering & cost optimization</span></li>
                  <li class="flex gap-2"><span>✓</span><span>Document processing automation</span></li>
                  <li class="flex gap-2"><span>✓</span><span>LLM agent scaffolding</span></li>
                </ul>
              </div>
              <div>
                <h4 class="text-xs font-semibold text-zinc-300 uppercase tracking-wider mb-2 font-display">Engagement Fit</h4>
                <ul class="space-y-1 text-xs text-zinc-400 font-body">
                  <li><strong>Ideal Client:</strong> SMEs looking to process documents or optimize customer interactions.</li>
                  <li><strong>Budget Scale:</strong> Scoped project based on token usage forecasts.</li>
                  <li><strong>Timeline:</strong> 3 to 6 weeks.</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Pricing / Engagement model prose -->
    <div class="max-w-4xl mx-auto px-4">
      <Prose>
        <h2>Our Engagement Model</h2>
        <p>
          We operate on a <strong>one-time scoped contract model</strong>. Here is how we ensure your project is completed within budget and without surprises:
        </p>
        <ul>
          <li><strong>Clear, upfront scope:</strong> We document every button, database table, and feature in a proposal document before any contract is signed.</li>
          <li><strong>Fixed pricing:</strong> You pay the exact amount written in the proposal. If a task is inside the agreed scope, it will never cost extra.</li>
          <li><strong>Optional post-launch support:</strong> After we hand over the code and files, we provide a standard support period (usually 30 days) to fix any bugs. After that, you can hire us for updates as needed, or choose a low-cost maintenance contract to cover updates.</li>
        </ul>
        <p>
          We keep our pricing structure highly competitive for SMEs and startups by avoiding administrative layers, fancy offices, and account managers. You only pay for active design and engineering.
        </p>
        <p class="pt-4 font-body">
          Ready to map out your project scope? <a href="/contact">Get in touch with us</a> to schedule a discovery call.
        </p>
      </Prose>
    </div>
  </main>
  <Footer />
</Layout>
